@model Contactform
@{
    ViewData["Title"] = "Contactpagina";
}

<head>
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <link rel="stylesheet" href="/css/spinner.css" />
</head>

<div class="page">
    <section class="contact">

        <h1>Contact</h1>
        <p>ViewBag.Message</p>
        <form asp-action="Index" method="post" class="form-contactpagina">

            <div id="contactForm" class="form-contactpagina__inputelement fx-col">
                <label for="firstname">Voornaam: </label>
                <input type="text" asp-for="FirstName" name="firstname" id="firstname" required>
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="lastname">Achternaam: </label>
                <input type="lastname" asp-for="LastName" name="lastname" id="lastname">
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="email">Email: </label>
                <input type="email" asp-for="Email" name="email" id="email">
            </div>

            <div class="form-contactpagina__inputelement fx-col">
                <label for="phone">Telefoonnummer: </label>
                <input type="tel" asp-for="Phone" name="phone" id="phone">
            </div>

            <div class="g-recaptcha" data-sitekey="6LcXVd8qAAAAALw6XieFFmiC_J1aWOXAu-zCAAXr"></div>

            <div class="form-contactpagina__inputelement">
                <input type="submit" value="Verstuur!">
            </div>

            <!-- Spinner -->
            <div id="spinner" class="spinner" style="display: none;"></div>

        </form>
        <script src="~/js/captcha.js"></script>
        <script>
            let spinner = document.getElementById("spinner");
            spinner.style.display = "block";
        </script>

    </section>

