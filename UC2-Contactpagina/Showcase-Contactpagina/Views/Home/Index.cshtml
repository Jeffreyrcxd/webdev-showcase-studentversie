@{
    ViewData["Title"] = "Home Page";
}

<div class="page">
    <section class="personalia">

        <img class="person-logo" src="images/profile-picture.png">
        <h1 class="person-name">Jeffrey Hu</h1>

    </section>

    <section class="profile">

        <section class="profile-content">

            <div class="profile-content__category--hidden-mobile">
                <h3 class="profile-content__category-title">Profiel</h3>
                <hr>
            </div>

            <div class="profile-content__element--hidden-mobile">
                <div class="profile-content__element-header">
                </div>
                <p class="profile-content__description">
                    Als arts developer en ben ik bekwaam in het onderzoeken van
                    de medische context en het zoeken van een technische oplossing.
                <p>
            </div>


            <div class="profile-content__category">
                <h3 class="profile-content__category-title">Opleidingen</h3>
                <hr>
            </div>

            <div class="profile-content__element">
                <div class="profile-content__element-header">
                    <h4 class="profile-content__title">HBO-ICT</h4>
                    <p class="profile-content__period">sep 2023 - heden</p>
                </div>
                <p class="profile-content__institute">Hogeschool Windesheim, Zwolle</p>
            </div>

            <div class="profile-content__category">
                <h3 class="profile-content__category-title">Werkervaring</h3>
                <hr />
            </div>

            <div class="profile-content__element">
                <div class="profile-content__element-header">
                    <h4 class="profile-content__title">Gastheer</h4>
                    <p class="profile-content__period">aug 2019 - heden</p>
                </div>
                <p class="profile-content__institute">Wok Oriental, Heerenveen</p>
            </div>

            <div class="profile-content__category--hidden-mobile">
                <div>
                    <h3 class="profile-content__category-title">Skills</h3>
                    <hr />
                </div>

                <div>
                    <p>HTML</p>
                    <div class="container">
                        <div class="skills html">90%</div>
                    </div>

                    <p>CSS</p>
                    <div class="container">
                        <div class="skills css">80%</div>
                    </div>

                    <p>JavaScript</p>
                    <div class="container">
                        <div class="skills js">65%</div>
                    </div>

                    <p>C#</p>
                    <div class="container">
                        <div class="skills cs">60%</div>
                    </div>
                </div>
            </div>

            

        </section>

    </section>
    <h1 id="content-gdpr-consent-status"></h1>

    <div class="content-gdpr-not-chosen hide">
        <p>Deze content wordt alleen getoond als gdrp consent niet is gekozen.</p>
    </div>

    <div class="content-gdpr-accept hide">
        <p>Deze content wordt alleen getoond als gdrp is geaccepteerd.</p>
    </div>

    <div class="content-gdpr-reject hide">
        <p>Deze content wordt alleen getoond als gdrp is verworpen.</p>
    </div>

    <section class="gdpr-consent hide">

        <div class="gdpr-consent__description">
            <p>
                Deze website gebruikt cookies.
                We gebruiken cookies om content te personaliseren, voor social media en het analyseren
                van verkeer op de website, advertenties.
            </p>
        </div>

        <div class="gdpr-consent__choice">
            <button class="gdpr-consent__button--accept">Ja, natuurlijk</button>
            <button class="gdpr-consent__button--reject">Neu, misschien later</button>
        </div>

    </section>

</div>
